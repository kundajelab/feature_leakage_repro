# ---- model weights (downloaded, not committed; see models/README.md) --------
models/*
!models/README.md
# the dermis ChromBPNet is not public elsewhere, so it is shipped with the repo
!models/chrombpnet/
models/chrombpnet/*
!models/chrombpnet/ENCSR000EPO_chrombpnet_wo_bias.h5

# ---- figure + experiment outputs (regenerated by the scripts) ---------------
figures/*/outputs/
experiments/*/outputs/

# ---- trained model artifacts written by scripts -----------------------------
figures/*/*.pth
figures/*/*.pkl
figures/*/labeled_peaks.bed
experiments/**/*.pkl
experiments/**/*.h5

# ---- training / experiment tracking clutter ---------------------------------
lightning_logs/
wandb/
figures/*/lightning_logs/
figures/*/wandb/
figures/*/notebooks/*/wandb/
*.log

# ---- python -----------------------------------------------------------------
__pycache__/
*.pyc
.ipynb_checkpoints/

# ---- local conda prefixes (env exports under env/ ARE kept) ------------------
env/*/

# ---- misc -------------------------------------------------------------------
.DS_Store
